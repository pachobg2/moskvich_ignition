#pragma once

// Rename this file to config.h and adjust. Keep config.h out of git (see
// .gitignore). Tuning values (timing table, dwell, limits ...) are NOT here --
// they live in the ECU's flash and are edited from the web app.

// ------------------------------------------------------------------
// WiFi access point (the ECU creates its own network; no router needed)
// ------------------------------------------------------------------
const char* AP_SSID         = "Moskvich-ECU";
const char* AP_PASSWORD     = "change-me-8chars";   // WPA2: 8-63 characters
const uint8_t AP_CHANNEL    = 1;
// Some C3 SuperMini boards have a poor antenna and misbehave at full power;
// WIFI_POWER_8_5dBm is plenty for a phone inside the car.
const wifi_power_t WIFI_TX_POWER = WIFI_POWER_11dBm;

// Password for firmware uploads (web /update page, user "admin", and ArduinoOTA)
const char* OTA_PASSWORD    = "choose-an-ota-password";

// ------------------------------------------------------------------
// Device identity
// ------------------------------------------------------------------
const char* DEVICE_MODEL      = "Moskvich ECU";
const char* DEVICE_HW_VERSION = "1.0";
const char* FIRMWARE_VERSION  = "1.0.0";

// ------------------------------------------------------------------
// Hardware (ESP32-C3 SuperMini)
// ------------------------------------------------------------------
// ADC pins must be on ADC1 (GPIO0-4): ADC2 is unusable while WiFi is on.
// Avoid GPIO2/8/9 strapping pins for anything that is driven at boot.
const int PIN_MAP    = 0;   // MAP sensor, via divider (ADC1_CH0)
const int PIN_VBAT   = 1;   // 12 V sense, via divider (ADC1_CH1)
const int PIN_POINTS = 4;   // conditioned points signal (NPN inverter: points open = pin LOW)
const int PIN_COIL   = 5;   // IGBT gate. HIGH = coil charging. External 10k pulldown REQUIRED.
const int PIN_LPG    = 3;   // LPG valve 12 V signal, via divider (ADC1_CH3)
const int PIN_LED    = 8;   // SuperMini on-board LED, active LOW
const bool LED_ACTIVE_LOW = true;

// MAP sensor: any linear 1-bar analog sensor. Slope/offset are NOT set here: use
// Setup -> MAP sensor in the web app (two-point calibration; defaults to an MPX4115).
const float MAP_DIV_RATIO   = 0.60f;     // ADC volts / sensor volts (10k over 15k -> 15/25)

// LPG signal divider (same 100k/22k as battery sense): ON above LPG_ON_MV, OFF below LPG_OFF_MV
const float LPG_DIV_RATIO   = 0.1803f;
const int   LPG_ON_MV       = 7000;
const int   LPG_OFF_MV      = 4000;

// 12 V sense divider: ADC volts / battery volts (100k over 22k -> 22/122)
const float VBAT_DIV_RATIO  = 0.1803f;
const int   VBAT_CAL_MV     = 0;         // fixed correction added to the computed battery mV
